# CasperOS Android — kernel config fragment
#
# Applied on top of an x86_64 defconfig, then resolved with `make olddefconfig`.
# Target: Linux 6.12 (matches the Debian kernel this project already boots, so
# the Bay Trail behaviour we have validated carries over).
#
# Why a fragment and not a full .config: a full config is unreadable in review
# and silently rots. A fragment states only the decisions that differ from
# defconfig, so every line is a deliberate choice with a reason.
#
# Anything marked (VERIFY) must be confirmed against the actual Kconfig of the
# kernel version being built. This project has previously been bitten by
# plausible-sounding config names that did not exist.

# ── Android: binder ───────────────────────────────────────────────────────
# Built in (=y), NOT modular. Android's init talks to the property service over
# binder before userspace module loading is meaningful; a modular binder needs
# an initramfs, a modules.dep, and correct load ordering at the earliest point
# of boot. =y removes an entire class of "binder not found" failures.
#
# NOTE: there is no CONFIG_ANDROID symbol. drivers/android/Kconfig defines only
# ANDROID_BINDER_IPC, ANDROID_BINDERFS, ANDROID_BINDER_DEVICES and
# ANDROID_BINDER_IPC_SELFTEST. A top-level CONFIG_ANDROID was in older trees and
# some LTS forks; it does not exist in 6.12. Verified against the 6.12 tree.
# CONFIG_ANDROID_BINDER_IPC is not set   # GNOME image: no Android runtime
# CONFIG_ANDROID_BINDERFS is not set

# Android 13+ uses memfd instead of ashmem (ashmem was removed from mainline in
# 5.18). Do not go looking for CONFIG_ASHMEM — it does not exist in 6.12.
# The Android side must have memfd support, which LineageOS 20+ does.

# ── Android: the memory feedback loop ────────────────────────────────────
# lmkd, Android's low-memory killer, is driven by PSI (pressure stall
# information), not by free-memory thresholds. Without CONFIG_PSI, lmkd
# degrades to polling and reacts late — which on 2 GB is the difference between
# killing a background app and freezing the foreground.
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_MEMCG=y
# NOTE: CONFIG_MEMCG_SWAP does not exist in 6.12 — it was folded into MEMCG.
# Verified: no MEMCG_SWAP symbol anywhere in the 6.12 Kconfig tree.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
# zswap is off: zram already presents a compressed swap device, and stacking
# zswap in front of it compresses twice for no benefit. One layer, not two.
CONFIG_ZSWAP=n

# ── zram ─────────────────────────────────────────────────────────────────
# The single highest-value memory feature on this device.
#
# In 6.12 the selectable compressors are gated by ZRAM_BACKEND_* bools (they
# `select` the matching CRYPTO_*/LZ4_* symbols themselves). Setting CRYPTO_LZ4=y
# directly does not give zram an lz4 option — that was the old arrangement.
# Verified against drivers/block/zram/Kconfig in the 6.12 tree.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
# Default is lz4: fastest decompress on Silvermont, and swap-in latency is on
# the critical path. zstd stays compiled in so it can be chosen at runtime for
# a second device where ratio matters more than speed.
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_ZPOOL=y
CONFIG_SWAP=y

# ── Bay Trail: the touchscreen freeze ────────────────────────────────────
# The LPSS I2C controller's clock is gated when the package enters deep
# C-states (PC6+), which stalls the bus the touch controller sits on. The
# runtime fix is `intel_idle.max_cstate=1` on the cmdline (see
# docs/optimizations.md); these configs make sure the controller and the HID
# transport are present in the first place.
CONFIG_X86_INTEL_LPSS=y
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_PINCTRL_BAYTRAIL=y
# Lynxpoint is the Haswell PCH. This tablet is Bay Trail (no PCH), so the GPIO
# driver it actually needs is the Bay Trail pinctrl above. There is no
# CONFIG_GPIO_LYNXPOINT — the symbol is PINCTRL_LYNXPOINT. Both verified; left
# off deliberately rather than added as a likely-useless driver.
CONFIG_INTEL_PMC_CORE=y
# Silead/Goodix panels are reached through i2c-hid on this device class. If
# the panel is a Silead needing the out-of-tree gslx680 driver, that is a
# separate patch, not a mainline config. (VERIFY against your panel's ID.)

# ── Gen7 graphics (4 EUs, H.264/VP8 decode only) ─────────────────────────
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_FBDEV_EMULATION=y
# VA-API decode: i915 + the i965/crocus userspace driver. On Gen7 the OpenGL
# driver is crocus (Mesa 21.2+); i965 classic is gone from modern Mesa.
CONFIG_DRM_I915_GVT=n
# Frame-buffer compression and PSR cause flicker/stalls on this GPU; the
# cmdline disables them, and leaving the configs on is harmless.

# ── Audio: RT5640 on Intel SST ───────────────────────────────────────────
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_RT5640=y
CONFIG_SND_SOC_INTEL_MACH=y

# ── Wi-Fi / Bluetooth: RTL8723BS (SDIO combo) ────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_STAGING=y
# RTL8723BS can ONLY be a module: drivers/staging/rtl8723bs/Kconfig declares
# `depends on m`, so CONFIG_RTL8723BS=y is impossible — Kconfig silently turns
# it back into =m (or off). Verified in the 6.12 tree. This is exactly the kind
# of assumption that produces a kernel which builds fine and has no Wi-Fi.
CONFIG_RTL8723BS=m
# Its dependencies, which a defconfig does not enable:
#   RTL8723BS depends on WLAN && MMC && CFG80211
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_DEFAULT_PS=n
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y

# ── Storage / I/O ────────────────────────────────────────────────────────
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
# BFQ is what this project already selected for the eMMC. Note that Android's
# own default is mq-deadline; measure both, they trade throughput for latency.
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_BLK_DEV_INITRD=y

# ── Boot chain: 32-bit firmware, 64-bit kernel ───────────────────────────
# THIS is what makes the whole device possible. The firmware is IA32-only; the
# CPU is x86_64. EFI_MIXED provides the thunk so a 64-bit kernel can be called
# from 32-bit firmware.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_PARTITION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# EFI_MIXED cannot be entered via the EFI stub; a loader using the EFI handover
# protocol must be used. GRUB does this correctly — see kernel/README.md.

# ── Power / scheduling ───────────────────────────────────────────────────
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
# kernel/sched: keep CFS, Android's EAS/UCLAMP tuning is for heterogeneous SoCs
# and is not applicable to four identical Silvermont cores.
CONFIG_HZ_250=y
# THP off: on 2 GB the khugepaged scanning costs more than the TLB wins, and
# latency spikes show up as UI stutter.
CONFIG_TRANSPARENT_HUGEPAGE=n

# ── Security posture (deliberate, disclosed) ─────────────────────────────
# Matches the Linux image's stance: this is a single-user personal tablet.
# Android itself will want SELinux in permissive at minimum, and enforcing for
# the vendor policy. Start permissive while bringing up, then tighten.
#
# Dependency chain, verified in security/selinux/Kconfig:
#     SECURITY_SELINUX depends on SECURITY_NETWORK && AUDIT && NET && INET
# AUDIT and NET/INET are not in a trimmed config, so they are requested
# explicitly here. Without them SELinux silently stays off and Android's init
# then fails in a way that looks like a binder problem. SELINUX_BOOTPARAM is
# what makes `androidboot.selinux=permissive` on the cmdline actually do
# anything — omit it and that cmdline parameter is inert.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_NETWORK_SECMARK=y
CONFIG_AUDIT=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# Auditing only the SELinux decision, not every syscall: audit=1 style breadth
# is real overhead on Silvermont and there is no auditd on this image.
CONFIG_AUDITSYSCALL=n

# ── IIO: accelerometer (MMA8653) ─────────────────────────────────────────
# CONFIG_IIO is REQUIRED, not optional. drivers/iio/accel/Kconfig is sourced
# inside 'if IIO', and MMA8452 does not 'select IIO' — it only selects
# IIO_BUFFER and IIO_TRIGGERED_BUFFER. Without IIO the MMA8452 symbol is
# invisible and the driver cannot be built at all.
CONFIG_IIO=y
# The mma8452 driver covers the MMA8653 (chip id 0x5a, 10-bit, addr 0x1d).
# =m because it is a leaf driver and need not be resident.
CONFIG_MMA8452=m
# iio-sensor-proxy in userspace consumes /sys/bus/iio and drives GNOME
# rotation. See docs/sensors-mma8653.md — the driver has no ACPI match table,
# so enumeration depends on how the firmware describes the device.
